---
import "../style/lenis.css";
import "../style/global.css";
import SeoHead from "../components/SEO/SeoHead.astro";
import SeoJsonLd from "../components/SEO/SeoJsonLd.astro";
import Header from "../components/Header/Header.astro";
import ScriptInject from "../components/system/scriptInject.astro";

import CssVariables from "../components/SEO/css-variables.astro";
import Footer from "../components/Footer/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  path?: string;
  lang?: string;
}
const { title, description, image, path = "/", lang = "en" } = Astro.props;
---

<html lang={lang}>
  <head>
    <CssVariables />
    <SeoHead title={title} description={description} image={image} path={path} />
    <SeoJsonLd path={path} description={description} />
    <script src="../libs/index.js"></script>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <ScriptInject />
    <ethan-backtop threshold="480">
      <button type="button" class="backtop-btn" aria-label="Back to top" hidden>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M11.9999 10.8284L7.0502 15.7782L5.63599 14.364L11.9999 8L18.3639 14.364L16.9497 15.7782L11.9999 10.8284Z"></path>
        </svg>
      </button>
    </ethan-backtop>
  </body>
</html>