---
import Spacer from "../common/Spacer.astro"
import { siteConfig } from "../../config/site"
import ImageRender from "../common/ImageRender.astro"
import HeadingBadge from "../common/HeadingBadge.astro"
import Heading from "../common/Heading.astro"
import Button from "../common/Button.astro"

// image

import img1 from "../../assets/images/sections/footer/1.jpg"
import img2 from "../../assets/images/sections/footer/2.jpg"
import img3 from "../../assets/images/sections/footer/3.jpg"
import img4 from "../../assets/images/sections/footer/4.jpg"

const sectionSettings = {
  label: "Start Building Today",
  title: `Launch Your<br> eCommerce Store<br> <span class="text-accent">Faster, Smarter, Better</span>`,
  sub: `Basel gives you everything you need to design, launch, and scale a high-<br>converting online store — without complexity or extra tools.`,
  buttons:[
    {
      label: "Buy Basel Now",
      href: siteConfig.buyUrl,
      variant: "accent",
    },
    {
      label: "View Live Demo",
      href: siteConfig.liveDemoUrl,
      variant: "transparent",
    },
  ],

  copyright: `© Basel Theme — Built for modern eCommerce businesses`
}

const widths = [20,40,60,80,100,140,180,220,260];
---

<footer>
  
  <div class="section-inner">
    <div class="footer-top">
      <Spacer space={siteConfig.sectionSpace.dk} spaceTb={siteConfig.sectionSpace.tb} spaceMb={siteConfig.sectionSpace.mb} />
      <div class="container">
        <div class="wrap">
          <div class="left">
            <div class="elip"></div>
            <div class="img1 img float-animation">
              <ImageRender src={img1} alt="Basel theme store preview on desktop" widths={widths} />
            </div>
            <div class="img2 img float-animation">
              <ImageRender src={img2} alt="Basel theme product page preview" widths={widths} />
            </div>
          </div>
          <div class="center text-align-center">
            <HeadingBadge label={sectionSettings.label} variant="primary" />
            <Spacer space={24} spaceTb={20} spaceMb={18} />
            <Heading level={1} textAlign="center" tag="h2">
              <span set:html={sectionSettings.title}></span>
            </Heading>
            <Spacer space={24} spaceTb={20} spaceMb={18} />
            <p class="text-secondary hide-br-mobile" set:html={sectionSettings.sub}></p>
            <Spacer space={48} spaceTb={36} spaceMb={30} />
            <div class="button-group">
              {sectionSettings.buttons.map((button) => (
                <Button label={button.label} variant={button.variant as "primary" | "accent" | "transparent"} href={button.href} />
              ))}
            </div>
          </div>
          <div class="right">
            <div class="elip"></div>
            <div class="img1 img float-animation">
              <ImageRender src={img3} alt="Basel theme collection page preview" widths={widths} />
            </div>
            <div class="img2 img float-animation">
              <ImageRender src={img4} alt="Basel theme homepage layout preview" widths={widths} />
            </div>
          </div>
        </div>

      </div>
      <Spacer space={siteConfig.sectionSpace.dk} spaceTb={siteConfig.sectionSpace.tb} spaceMb={siteConfig.sectionSpace.mb} />
    </div>
  </div>
  <div class="footer-bottom">
    <div class="line"></div>
    <div class="container">
      <Spacer space={32} spaceTb={24} spaceMb={20} />
      <p class="text-secondary text-align-center" set:html={sectionSettings.copyright}></p>
      <Spacer space={32} spaceTb={24} spaceMb={20} />
    </div>
  </div>
</footer>


<style>
  footer{
    background-color: #000;
    --text: #fff;
    --btn-text-transparent: #fff;
    .text-secondary{
      color: #ccc;
    }

  }
  .wrap{
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2rem;
    @media (width < 992px){
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
  .img{
    border: 2px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-sm);
    overflow: hidden;
    height: fit-content;
  }
  .left,
  .right{
    position: relative;
    width: 280px;
    display: grid;
    grid-template-columns: repeat(12,1fr);
    grid-template-rows: repeat(12,1fr);
    gap: 16px;
    .elip{
      position: absolute;
      width: 25vw;
      height: 18vw;
      top: 50%;
      left: 50%;
      transform: translate(-50%,-50%);
      background-color: var(--accent-color);
      filter: blur(528px);
      opacity: 0.65;
      border-radius: 9999px;
      pointer-events: none;
      @media (width < 1500px){
        filter: blur(100px);
      }
    }
    .img1{
      grid-column: 1/11;
      grid-row: 1/ 7;
    }
    .img2{
      grid-column: 6/13;
      grid-row: 7/13;
    }
  }
  .right{
    .img1{
      grid-column: 3/13;
    }
    .img2{
      grid-column: 1/8;
    }
    .elip{
      opacity: 0.5;
    }
  }
  @media (width < 991px){
    .left,
    .right{
      display: block;
      margin-inline: auto;
      .elip{
        width: 50vw;
        height: 50vw;
        
      }
      .img1,.img2{
        display: none;
      }
    }
  }
  .footer-bottom{
   
    .line{
      margin-inline: auto;
      width: calc(100vw - 160px);
      background-color: #FFFFFF3D;
      height: 1px;
      @media (width < 1580px) {
          width: calc(100vw - 4vw);
      }
    }
  }
</style>