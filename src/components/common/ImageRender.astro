---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  loading?: "lazy" | "eager";
  decoding?: "async" | "sync" | "auto";
  quality?: number;
  format?: "avif" | "webp" | "jpg" | "png";
  class?: string;
  ratio?: "adapt-image" | "3-2" | "asos" | "portrait" | "square" | "4-3" | "landscape";
  href?: string;
}

const {
  src,
  alt,
  widths = [100,200,300,400,500,600,700,800,900,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000],
  sizes = "",
  loading = "lazy",
  decoding = "async",
  quality = 80,
  format = "webp",
  class: className = "",
  ratio = "adapt-image",
  href = "",
} = Astro.props;

function parseRatio(value: string | number): number | null {
  if (typeof value === "number") return value > 0 ? value : null;
  if (value.includes("/")) {
    const [w, h] = value.split("/").map(Number);
    return w > 0 && h > 0 ? w / h : null;
  }
  const n = Number(value);
  return n > 0 ? n : null;
}
const autoRatio = src.width / src.height;
const finalRatio = ratio === "adapt-image" ? autoRatio : (parseRatio(ratio) ?? autoRatio);

---

{href ? (
  <a href={href} class={`image-render-container ${className} ratio-${ratio}`} >
    <div class="ratio" style={ratio === "adapt-image" ? `--aspect-ratioapt: ${finalRatio};` : ""}>
      <Image
        src={src}
        alt={alt}
        widths={widths}
        sizes={sizes}
        loading={loading}
        decoding={decoding}
        quality={quality}
        format={format}
      />
    </div>
  </a>
) : (
  <div class={`image-render-container ${className} ratio-${ratio}`}>
    <div class="ratio" style={ratio === "adapt-image" ? `--aspect-ratioapt: ${finalRatio};` : ""}>
      <Image
        src={src}
        alt={alt}
        widths={widths}
        sizes={sizes}
        loading={loading}
        decoding={decoding}
        quality={quality}
        format={format}
      />
    </div>
  </div>
)}