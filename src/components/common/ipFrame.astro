---
import Spacer from './Spacer.astro';

interface Props {
  src?: string;
  title?: string;
  poster?: string;
}
const { src, title, poster } = Astro.props;
---

<div class="ipframe ratio-2-1">
  <div class="fr-15">
    <div class="fr-bd">
      <div class="fr-dynamic"></div>
      <div class="fr-action">
        <div class="fr-touch"></div>
        <div class="fr-power"></div>
        <div class="fr-vl-up"></div>
        <div class="fr-vl-down"></div>
      </div>
      <div class="fr-body">
        <ethan-lazy-video data-threshold="0.25" class="ratio">
          <video
            muted
            playsinline
            loop
            preload="metadata"
            autoplay
          >
            <source src={src} type="video/mp4" />
          </video>
        </ethan-lazy-video>
      </div>
    </div>
  </div>
  <Spacer space={24} spaceTb={16} spaceMb={12} />
  {title && <h3 class="ipframe-title text-align-center">{title}</h3>}
</div>

<style>
  .ipframe{
    max-width: 390px;
    margin: 0 auto;
  }
  .fr-15{
    --radius: 40px;
    --padding: 6px;
    --radius-inner: calc(var(--radius) - var(--padding));
    --action-color: rgb(255,255,255,0.4);
    pointer-events: none;
  }
  .fr-bd{
    position: relative;
    border-radius: var(--radius);
    padding: var(--padding);
    background-color: rgb(0,0,0,1);
    border: 0.5px solid rgb(255,255,255,0.5);
  }
  .fr-body{
    border-radius: var(--radius-inner);
    overflow: hidden;
  }
  .fr-dynamic{
    position: absolute;
    width: 120px;
    height: 25px;
    border-radius: 9999px;
    left: 50%;
    top: 15px;
    transform: translateX(-50%);
    background-color: rgb(0,0,0,1);
    z-index: 10;
  }
  .fr-action{
    position: absolute;
    inset: 0;
    width: calc(100% + 5px);
    height: calc(100% + 5px);
  }
  .fr-touch{
    position: absolute;
    width: 3px;
    height: 30px;
    background-color: var(--action-color);
    left: -2px;
    top: 15%;
    border-radius: 9999px;
  }
  .fr-vl-down,
  .fr-vl-up,
  .fr-power{
    width: 3px;
    height: 50px;
    background-color: var(--action-color);
    position: absolute;
    left: -3px;
    border-radius: 9999px;
  }
  .fr-vl-up{
    top: 23%;
  }
  .fr-vl-down{
    top: calc(23% + 60px);
  }
  .fr-power{
    top: calc(23%);
    right: 3px;
    left: unset;
    height: 80px;
  }

  video{
    object-fit: cover;
  }
  .ipframe-title{
    --fs: 20px;
    --fw: 500;
    --lh: 1.3;
    --ls: -3;
    font-size: var(--fs);
    font-weight: var(--fw);
    line-height: var(--lh);
    letter-spacing: calc(var(--fs) * ( var(--ls) / 100));
    color: var(--text);
  }
</style>