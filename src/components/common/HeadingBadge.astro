---
interface Props {
  label: string;
  variant?: "primary" | "accent";
}
const { label, variant = "primary" } = Astro.props;

const className = [
  "heading-badge",
  `heading-badge--${variant}`,
]
  .filter(Boolean)
  .join(" ");

---

<div class={className}>{label}</div>

<style>
  .heading-badge{
    --fs: 14px;
    --fw: 500;
    --lh: 1.3;
    --ls: -3;
    --padding: 7px 12px;
    --radius: var(--hd-badge-radius);
    --elevation-shadow: #0000000A;
    --box-shadow: 0px 24px 24px -12px var(--elevation-shadow), 0px 3px 3px -1.5px var(--elevation-shadow),  0px 1px 1px -0.5px var(--elevation-shadow);
    --border: 0.5px solid #EFEFEF;

    font-size: var(--fs);
    font-weight: var(--fw);
    line-height: var(--lh);
    letter-spacing: calc(var(--fs) * ( var(--ls) / 100));
    color: var(--text);
    background-color: var(--bg);
    padding: var(--padding);
    border-radius: var(--radius);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: background-color .3s ease, color .3s ease;
    box-shadow: var(--box-shadow);
    border: var(--border);
    user-select: none;
    position: relative;
    z-index: 1;
  }
  .heading-badge--primary{
    --bg: var(--hd-badge-bg-primary);
    --text: var(--hd-badge-text-primary);
  }
  .heading-badge--accent{
    --bg: var(--hd-badge-bg-accent);
    --text: var(--hd-badge-text-accent);
  }
</style>