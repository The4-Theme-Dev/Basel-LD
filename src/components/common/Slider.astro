---
interface Props {
  type?: "default" | "marquee";
  direction?: "horizontal" | "vertical";
  directionMb?: "horizontal" | "vertical";
  reverse?: boolean;
  autoplay?: boolean;
  interval?: number;
  loop?: boolean;
  speed?: number;
  slidesPerViewXL?: number | string;
  slidesPerView?: number | string;
  slidesPerViewTb?: number | string;
  slidesPerViewMb?: number | string;
  spaceBetweenXL?: number;
  spaceBetween?: number;
  spaceBetweenTb?: number;
  spaceBetweenMb?: number;
  className?: string;
}

const {
  type = "default",
  direction = "horizontal",
  directionMb = direction,
  reverse = false,
  autoplay = false,
  interval = 3000,
  loop = true,
  speed = 8000,
  slidesPerView = 3,
  slidesPerViewXL = slidesPerView,
  slidesPerViewTb = 2,
  slidesPerViewMb = 1,
  spaceBetween = 0,
  spaceBetweenXL = spaceBetween,
  spaceBetweenTb = 20,
  spaceBetweenMb = 16,
  className = ""
} = Astro.props;

const isMarquee = type === "marquee";

const finalClassName =
  direction === "vertical"
    ? `${className} slider-vertical`.trim()
    : directionMb === "vertical"
    ? `${className} slider-vertical-mb`.trim()
    : className;

const config = {
  direction,
  directionMb,
  loop,
  speed: isMarquee ? speed : 600,
  allowTouchMove: true,
  grabCursor: true,
  autoplay: autoplay
    ? {
        delay: isMarquee ? 0 : interval,
        disableOnInteraction: false,
        pauseOnMouseEnter: true,
        reverseDirection: reverse
      }
    : false,
  watchSlidesProgress: true,
  observer: true,
  observeParents: true,
  breakpoints: {
    0: { slidesPerView: slidesPerViewMb, spaceBetween: spaceBetweenMb, direction: directionMb },
    768: { slidesPerView: slidesPerViewTb, spaceBetween: spaceBetweenTb, direction: direction },
    1024: { slidesPerView: slidesPerView, spaceBetween: spaceBetween, direction: direction },
    2000: { slidesPerView: slidesPerViewXL, spaceBetween: spaceBetweenXL, direction: direction }
  }
};
---

<ethan-slider class={finalClassName} data-config={JSON.stringify(config)}>
  <swiper-container init="false">
    <slot />
  </swiper-container>
</ethan-slider>

<style>
  .slider-vertical {
    display: block;
    --slide-height: var(--height, 500px);
    --slide-height-tb: var(--height-tb, var(--height));
    --slide-height-mb: var(--height-mb, var(--height));
    height: var(--slide-height);
    @media (width < 1024px){
      --slide-height: var(--slide-height-tb);
    }    
    @media (width < 767px){
      --slide-height: var(--slide-height-mb);

      &:not(.slider-vertical-mb){
        height: auto !important;
      }
    }
  }
  .slider-vertical swiper-container {
    height: 100%;
  }
  .slider-vertical :global(swiper-slide){
    height: auto;
  }
  swiper-container::part(wrapper){
    transition-timing-function: linear !important;
  }
</style>
<!-- 
How to use:
default: 
  <Slider type="marquee" autoplay />

Vertical: Down to up: 
  <Slider type="marquee" direction="vertical" autoplay />

Vertical: Up to down: 
  <Slider type="marquee" direction="vertical" reverse autoplay />


No marquee:

  <Slider
    slidesPerView={3}
    slidesPerViewTb={2}
    slidesPerViewMb={1}
    spaceBetween={24}
    spaceBetweenTb={20}
    spaceBetweenMb={16}
  >
    <swiper-slide>...</swiper-slide>
    <swiper-slide>...</swiper-slide>
    <swiper-slide>...</swiper-slide>
  </Slider>

Marquee default: 

  <Slider
    type="marquee"
    autoplay={true}
    interval={0}
    speed={9000}
    loop={true}
    slidesPerView={4}
    slidesPerViewTb={3}
    slidesPerViewMb={2}
    spaceBetween={20}
  >
    <swiper-slide>...</swiper-slide>
    <swiper-slide>...</swiper-slide>
    <swiper-slide>...</swiper-slide>
  </Slider>

Marquee vertical: Down to up: 

  <div class="hero-vertical-slider">
    <Slider
      type="marquee"
      direction="vertical"
      autoplay={true}
      speed={10000}
      loop={true}
      slidesPerView={3}
      spaceBetween={16}
    >
      <swiper-slide>...</swiper-slide>
      <swiper-slide>...</swiper-slide>
      <swiper-slide>...</swiper-slide>
    </Slider>
  </div>

Marquee vertical: Up to down: 

  <Slider
    type="marquee"
    direction="vertical"
    reverse={true}
    autoplay={true}
    speed={10000}
    loop={true}
  >
    <swiper-slide>...</swiper-slide>
    <swiper-slide>...</swiper-slide>
  </Slider>
