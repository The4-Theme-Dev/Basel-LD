---
import Button from "../common/Button.astro";


---

<password-popup style="opacity: 0;">
  <div class="overlay"></div>
  <div class="pp-inner">
    <button aria-label="Close" class="pp-close">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="currentColor">
        <path d="M14 1.41L12.59 0L7 5.59L1.41 0L0 1.41L5.59 7L0 12.59L1.41 14L7 8.41L12.59 14L14 12.59L8.41 7L14 1.41Z">
        </path>
      </svg>
    </button>
    <div class="pp-body">
      <p class="pp-body-text">Please enter store password "<span class="text-accent">4</span>" to view live demo</p>
      <Button label="View demo" variant="accent" href="#" attributes={{ "url-accepted": "" }}/>
      <span class="pp-body-text-small">WE APOLOGIZE FOR THIS INCONVENIENCE!</span>
    </div>
  </div>
</password-popup>

<style>
  password-popup{
    position: fixed;
    inset: 0;
    z-index: 9999;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;


    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    &[open]{
      opacity: 1 !important;
      pointer-events: auto;
    }
  }
  .overlay{
    position: absolute;
    inset: 0;
    background-color: rgba(0,0,0,0.7);
    z-index: 1;
    cursor: pointer;
    filter: blur(10px);
    transition: all 0.3s ease;
  }
  .pp-inner{
    position: relative;
    z-index: 2;
    width: min(100vw,550px);
    border-radius: var(--radius);
    background-color: var(--bg);
    padding: clamp(20px, 5vw, 32px);
  }
  .pp-close{
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 3;
    background-color: transparent;
    border: none;
    cursor: pointer;
    transition: all 0.25s ease;
    &:hover{
      color: var(--accent-color);
    }
  }
  .pp-body-text{
    --fs: clamp(28px, 3vw, 30px);
    --fw: 400;
    --lh: 1.3;
    --ls: -3;
    font-size: var(--fs);
    font-weight: var(--fw);
    line-height: var(--lh);
    letter-spacing: calc(var(--fs) * ( var(--ls) / 100));
    color: var(--text);
    margin-bottom: 20px;
  }
  .pp-body-text-small{
    --fs: 12px;
    --fw: 700;
    --lh: 1.3;
    --ls: -3;
    font-size: var(--fs);
    font-weight: var(--fw);
    line-height: var(--lh);
    letter-spacing: calc(var(--fs) * ( var(--ls) / 100));
    color: var(--text-secondary);
    display: block;
    margin-top: 15px;
  }
</style>