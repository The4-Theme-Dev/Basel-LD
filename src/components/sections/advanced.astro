---
import HeadingBadge from "../common/HeadingBadge.astro"
import Spacer from "../common/Spacer.astro"
import Heading from "../common/Heading.astro"
import { siteConfig } from "../../config/site"

import ImageRender from "../common/ImageRender.astro"
import AccordionGroup from "../common/AccordionGroup.astro"
import Accordion from "../common/Accordion.astro"

// import video
import ajaxsearch from '../../assets/videos/ajaxsearch.mp4'
import ajaxshop from '../../assets/videos/ajaxshop.mp4'
import quickadd from '../../assets/videos/quickadd.mp4'
import quickview from '../../assets/videos/quickview.mp4'
import stickyatc from '../../assets/videos/stickyatc.mp4'
import swatches from '../../assets/videos/swatches.mp4'

const sectionId = `advanced-${crypto.randomUUID().slice(0, 8)}`

const sectionSettings = {
  label: "Advanced eCommerce Experience",
  title: "Built to Power Modern eCommerce",
  sub: `Basel goes beyond standard Shopify functionality with a suite of advanced features<br> designed to improve product discovery, streamline shopping, and increase conversions across your<br> entire store.`,


  features: [
    {
      title: "Ajax Search",
      sub: `Deliver instant search results with real-time suggestions, helping customers find products faster and reduce drop-offs.`,
      video: ajaxsearch
    },
    {
      title: "Quick View",
      sub: `Preview products instantly without leaving the page. Let customers explore details, variants, and pricing in a seamless popup experience.`,
      video: quickview
    },
    {
      title: "Product Swatches",
      sub: `Display product variations with intuitive color, size, and style swatches to help customers choose faster and more confidently.`,
      video: swatches
    },
    {
      title: "Quick Shop",
      sub: `Enable fast add-to-cart directly from collection pages, reducing steps and boosting conversion rates.`,
      video: quickadd
    },
    {
      title: "Ajax Shop",
      sub: `Deliver a smooth shopping experience with dynamic cart updates, filters, and interactions—no page reloads needed.`,
      video: ajaxshop
    },
    {
      title: "Sticky Add to Cart",
      sub: `Keep the add-to-cart button always visible while scrolling, ensuring customers can purchase anytime without friction.`,
      video: stickyatc
    },
  ]
}
---

<section class="advanced-section">
  <Spacer space={siteConfig.sectionSpace.dk} spaceTb={siteConfig.sectionSpace.tb} spaceMb={siteConfig.sectionSpace.mb} />
  <div class="section-inner">
    <div class="container">
      <div class="section-heading text-align-center" data-gsap-heading>
        <HeadingBadge label={sectionSettings.label} variant="primary" reveal={false} />
        <Spacer space={24} spaceTb={20} spaceMb={18} />
        <Heading level={2} textAlign="center" tag="h2" reveal={false}>
          {sectionSettings.title}
        </Heading>
        <Spacer space={24} spaceTb={20} spaceMb={18} />
        <p class="text-align-center text-secondary hide-br-mobile" set:html={sectionSettings.sub}></p>
        <Spacer space={48} spaceTb={40} spaceMb={30} />
      </div>
      <features-layout>
        <div class="item">
          <div class="item-inner">
            <div class="left">
              <div class="wrap-content">
                <AccordionGroup ariaControls={`${sectionId}-content`} interval={10000}>
                  {sectionSettings.features.map((item,index) => (
                    <Accordion open={index === 0} attributes={{ 'data-index': String(index) }}>
                      <h3 slot="title">{item.title}</h3>
                      <div>
                        <p set:html={item.sub}></p>
                      </div>
                    </Accordion>
                  ))}
                </AccordionGroup>
              </div>
            </div>
            <div class="right">
              <div id={`${sectionId}-content`} class="accordion-wrap">
                {sectionSettings.features.map((item,index) => (
                  <div class:list={['content-item', { 'is-active': index === 0 }]}>
                    <video src={item.video} autoplay muted loop playsinline preload="metadata"></video>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </features-layout>
    </div>
  </div>
  <Spacer space={siteConfig.sectionSpace.dk} spaceTb={siteConfig.sectionSpace.tb} spaceMb={siteConfig.sectionSpace.mb} />
</section>

<style>
  features-layout{
    display: block;
    position: relative;
  }
  .item-inner{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    align-items: center;
    @media (width < 767px){
      grid-template-columns: 1fr;
    }
  }
  .right{
    position: relative;
    @media (width < 767px){
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      opacity: 0.25;
    }
  }
  .left{
    z-index: 2;
  }
  .content-item{
    position: absolute;
    left: 0;
    width: 100%;
    top:0;
    pointer-events: none;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.7s cubic-bezier(0.77, 0, 0.175, 1);
    &.is-active{
      position: relative;
      clip-path: inset(0);
    }
    img{
      object-fit: cover;
      object-position: top;
    }
    video{
      width: 100%;
    }
  }

</style>