---
import { siteConfig } from "../../config/site"

// icon
import ecom from '../../assets/icon/app/ecom.svg'
import kla from '../../assets/icon/app/kla.svg'
import fontify from '../../assets/icon/app/fontify.svg'
import er from '../../assets/icon/app/er.svg'
import avada from '../../assets/icon/app/avada.svg'
import mc from '../../assets/icon/app/mc.svg'
import fordeer from '../../assets/icon/app/fordeer.svg'
import transcy from '../../assets/icon/app/transcy.svg'
import HeadingBadge from "../common/HeadingBadge.astro"
import Heading from "../common/Heading.astro"
import Spacer from "../common/Spacer.astro"
import Button from "../common/Button.astro"
import Slider from "../common/Slider.astro"

const sectionSettings = {
  label: "Extend Your Store Without Limits",
  title: `Compatible with<br> Tools You Already Trust`,
  sub: `Seamlessly integrate with the most popular WordPress and<br> WooCommerce plugins to build, optimize, and scale your business<br> with confidence.`,
  
  buttons: [
    {
      label: "Claim Your Deal",
      href: siteConfig.claimDealUrl,
      variant: "primary",
    },
    {
      label: `Buy Basel Now - ${siteConfig.moneyPrefix}${siteConfig.originPrice}`,
      href: siteConfig.buyUrl,
      variant: "transparent",
    }
  ],

  items: [
    [
      {
        icon: ecom,
        title: `EComposer Landing Page Builder`,
        sub: "Free plan available"
      },
      {
        icon: kla,
        title: `Klaviyo: Email Marketing & SMS`,
        sub: "Free plan available"
      },
      {
        icon: ecom,
        title: `EComposer Landing Page Builder`,
        sub: "Free plan available"
      },
      {
        icon: kla,
        title: `Klaviyo: Email Marketing & SMS`,
        sub: "Free plan available"
      },
    ],
    [
      {
        icon: fontify,
        title: `Fontify: Google & Custom Fonts`,
        sub: "Free plan available"
      },
      {
        icon: er,
        title: `EcomRise: Upsell & Bundles`,
        sub: "Free plan available"
      },
      {
        icon: fontify,
        title: `Fontify: Google & Custom Fonts`,
        sub: "Free plan available"
      },
      {
        icon: er,
        title: `EcomRise: Upsell & Bundles`,
        sub: "Free plan available"
      },
    ],
    [
      {
        icon: avada,
        title: `Avada AI SEO Image Optimizer`,
        sub: "Free plan available"
      },
      {
        icon: mc,
        title: `Mailchimp Email SMS Marketing`,
        sub: "Free plan available"
      },
      {
        icon: avada,
        title: `Avada AI SEO Image Optimizer`,
        sub: "Free plan available"
      },
      {
        icon: mc,
        title: `Mailchimp Email SMS Marketing`,
        sub: "Free plan available"
      },
    ],
    [
      {
        icon: fordeer,
        title: `Fordeer: Product Labels & Badges`,
        sub: "Free plan available"
      },
      {
        icon: transcy,
        title: `Transcy: AI Language Translate`,
        sub: "Free plan available"
      },
      {
        icon: fordeer,
        title: `Fordeer: Product Labels & Badges`,
        sub: "Free plan available"
      },
      {
        icon: transcy,
        title: `Transcy: AI Language Translate`,
        sub: "Free plan available"
      },
    ]
  ],

  itemperRow: 2,
  itemperRowTb: 2,
  itemperRowMb: 1.3,

  itemperRow2: 2.3,
  itemperRow3: 2.5,
  
  itemSpaceBetween: 16,
  itemSpaceBetweenTb: 16,
  itemSpaceBetweenMb: 16,
}
---

<section class="app-compare-section">
  <Spacer space={siteConfig.sectionSpace.dk} spaceTb={siteConfig.sectionSpace.tb} spaceMb={siteConfig.sectionSpace.mb} />
  <div class="section-inner">
    <div class="container">
      <div class="wrap">
        <div class="wrap-info">
          <HeadingBadge label={sectionSettings.label} variant="primary" />
          <Spacer space={24} spaceTb={20} spaceMb={18} />
          <Heading level={2} textAlign="left" tag="h2">
            <p set:html={sectionSettings.title}></p>
          </Heading>
          <Spacer space={24} spaceTb={20} spaceMb={18} />
          <p class="text-secondary hide-br-mobile" set:html={sectionSettings.sub}></p>
          <Spacer space={48} spaceTb={36} spaceMb={30} />
          <div class="button-group">
            {sectionSettings.buttons.map((button) => (
              <Button label={button.label} variant={button.variant as "primary" | "accent" | "transparent"} href={button.href} />
            ))}
          </div>
        </div>
        <div class="wrap-item">
          {sectionSettings.items.map((line,index) => (
            <div class="wrap-item-slider">
              <Slider type="marquee" reverse={index % 2 === 1} autoplay={true} interval={0} speed={7000} loop={true} slidesPerView={index === 0 ? sectionSettings.itemperRow : index === 1 ? sectionSettings.itemperRow2 : index === 2 ? sectionSettings.itemperRow3 : sectionSettings.itemperRow} slidesPerViewTb={sectionSettings.itemperRowTb} slidesPerViewMb={sectionSettings.itemperRowMb} spaceBetween={sectionSettings.itemSpaceBetween} spaceBetweenTb={sectionSettings.itemSpaceBetweenTb} spaceBetweenMb={sectionSettings.itemSpaceBetweenMb}>
                {line.map((item) => (
                  <swiper-slide>
                    <div class="wrap-item-card">
                      <item.icon/>
                      <div class="info">
                        <h6 class="title">{item.title}</h6>
                        <p class="sub text-secondary" set:html={item.sub}></p>
                      </div>
                    </div>
                  </swiper-slide>
                ))}
              </Slider>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
  <Spacer space={siteConfig.sectionSpace.dk} spaceTb={siteConfig.sectionSpace.tb} spaceMb={siteConfig.sectionSpace.mb} />
</section>

<style>
  .wrap{
    display: grid;
    grid-template-columns: 4fr 6fr;
    gap: 64px;
    swiper-container {
      min-width: 0;
    }
    @media (width < 1024px){
      grid-template-columns: 1fr ;
      gap: 40px;
    }
    @media (width < 767px){
      gap: 32px;
    }
  }
  .wrap-item-slider + .wrap-item-slider{
    margin-top: 16px;
  }
  .wrap-item{
    position: relative;
    overflow: hidden;
    pointer-events: none;
    &::before,
    &::after{
      position: absolute;
      content: "";
      height: 100%;
      width: 3vw;
      top: 0;
      bottom: 0;
      left: 0;
      background: linear-gradient(to left, rgba(240, 240, 240, 0) 0%, #F0F0F0 100%);
      z-index: 10;
      pointer-events: none;
    }
    &::after{
      left: unset;
      right: 0;
      background: linear-gradient(to right, rgba(240, 240, 240, 0) 0%, #F0F0F0 100%);
    }
  }
  .wrap-item-card{
    display: flex;
    gap: 16px;
    padding: 16px;
    border-radius: var(--radius);
    background-color: #fff;

    .title{
      --fs: 17px;
      --fw: 500;
      --lh: 1.3;
      --ls: -3;

      font-size: var(--fs);
      font-weight: var(--fw);
      line-height: var(--lh);
      letter-spacing: calc(var(--fs) * ( var(--ls) / 100));
      color: var(--text);
    }
    .sub{
      --fs: 14px;
      --fw: 400;
      --lh: 1.35;
      --ls: -3;
      
      font-size: var(--fs);
      font-weight: var(--fw);
      line-height: var(--lh);
      letter-spacing: calc(var(--fs) * ( var(--ls) / 100));
      color: var(--text-secondary);
      margin-top: 8px;
    }
  }
  /* swiper-slide{
    transition: opacity .3s linear;
    opacity: 0.4;
    &.swiper-slide-active,
    &.swiper-slide-next{
      opacity: 1;
    }
  } */
</style>