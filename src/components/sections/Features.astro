---
import { siteConfig } from "../../config/site"
import Heading from "../common/Heading.astro"
import Spacer from "../common/Spacer.astro"
import HeadingBadge from "../common/HeadingBadge.astro"

// import icon
import demoimport from '../../assets/icon/features/export.svg'
import themesettings from '../../assets/icon/features/themesettings.svg'
import responsive from '../../assets/icon/features/responsive.svg'
import megamenu from '../../assets/icon/features/mega.svg'
import language from '../../assets/icon/features/language.svg'
import translate from '../../assets/icon/features/translate.svg'
import seo from '../../assets/icon/features/seo.svg'
import video from '../../assets/icon/features/video.svg'
import performance from '../../assets/icon/features/performance.svg'
import woo from '../../assets/icon/features/woo.svg'
import builder from '../../assets/icon/features/builder.svg'
import slidepre from '../../assets/icon/features/slidepre.svg'
import svg from '../../assets/icon/features/svg.svg'
import font from '../../assets/icon/features/font.svg'
import ajax from '../../assets/icon/features/ajax.svg'
import support from '../../assets/icon/features/support.svg'
import update from '../../assets/icon/features/update.svg'
import browser from '../../assets/icon/features/browser.svg'

const sectionSettings = {
  label: "General Features List",
  title: "Everything You Need to Build & Scale",
  sub: `A complete toolkit packed with powerful features to help you launch faster, customize easier,<br> and grow your eCommerce business without limits.`,

  itemPerRow: 3,
  itemPerRowTb: 2,
  itemPerRowMb: 1,
  itemSpaceBetween: 32,
  itemSpaceBetweenTb: 20,
  itemSpaceBetweenMb: 16,
  limit: 99,

  features: [
    {
      icon: demoimport,
      title: "One-Click Demo Import",
      description: "Launch your store instantly by importing ready-made demos in seconds."
    },
    {
      icon: themesettings,
      title: "Powerful Theme Settings",
      description: `Customize every detail of your store without<br> touching code.`
    },
    {
      icon: responsive,
      title: "Fully Responsive & Retina Ready",
      description: `Deliver a flawless experience across all devices<br> and screen sizes.`
    },
    {
      icon: megamenu,
      title: "Built-in Mega Menu",
      description: `Create rich, structured navigation with images,<br> banners, and categories.`
    },
    {
      icon: language,
      title: "RTL & Multilingual Support",
      description: `Support right-to-left languages and global<br> audiences with ease.`
    },
    // {
    //   icon: translate,
    //   title: "WPML & Translation Ready",
    //   description: `Translate your store into multiple languages<br> seamlessly.`
    // },
    {
      icon: seo,
      title: "SEO Optimized Structure",
      description: `Built with clean code and best SEO <br>practices.`
    },
    {
      icon: video,
      title: "Video Tutorials Included",
      description: `Step-by-step guides to help you set up and<br> customize your store.`
    },
    {
      icon: performance,
      title: "Performance Optimized",
      description: `Fast loading speeds and smooth interactions<br> across the site.`
    },
    // {
    //   icon: woo,
    //   title: "WooCommerce Ready",
    //   description: `Fully compatible with WooCommerce core and<br> extensions.`
    // },
    // {
    //   icon: builder,
    //   title: "Drag & Drop Builder Included",
    //   description: `Create pages visually with no coding <br>required.`
    // },
    {
      icon: slidepre,
      title: "Premium Slider Included",
      description: `Build engaging hero sections and promotional<br> sliders easily.`
    },
    {
      icon: svg,
      title: "SVG Icons & Vector Support",
      description: `Crisp, scalable visuals for a modern <br>UI experience.`
    },
    {
      icon: font,
      title: "800+ Google Fonts",
      description: `Choose from a wide range of typograph <br>options.`
    },
    {
      icon: ajax,
      title: "AJAX Filters & Dynamic Shop",
      description: `Filter products instantly without <br>reloading pages.`
    },
    {
      icon: support,
      title: "Dedicated Support",
      description: `Get help whenever you need it from our support team.`
    },
    {
      icon: update,
      title: "Free Lifetime Updates",
      description: `Stay up-to-date with new features and<br> improvements.`
    },
    {
      icon: browser,
      title: "Cross-Browser Compatibility",
      description: `Works flawlessly across all modern <br>browsers.`
    },
  ]
}
---

<section id="features" class="features-section">
  <Spacer space={siteConfig.sectionSpace.dk} spaceTb={siteConfig.sectionSpace.tb} spaceMb={siteConfig.sectionSpace.mb} />
  <div class="section-inner">
    <div class="container">
      <div class="section-heading text-align-center" data-gsap-heading>
        <HeadingBadge label={sectionSettings.label} variant="primary" reveal={false} />
        <Spacer space={24} spaceTb={20} spaceMb={18} />
        <Heading level={2} textAlign="center" tag="h2" reveal={false}>
          {sectionSettings.title}
        </Heading>
        <Spacer space={24} spaceTb={20} spaceMb={18} />
        <p class="text-align-center text-secondary hide-br-mobile" set:html={sectionSettings.sub}>
        </p>
        <Spacer space={64} spaceTb={40} spaceMb={30} />
      </div>
      <reveal-grid class="features-list" data-gsap-stagger="0.06" style={`--per-row: ${sectionSettings.itemPerRow}; --per-row-tb: ${sectionSettings.itemPerRowTb}; --per-row-mb: ${sectionSettings.itemPerRowMb}; --space-between: ${sectionSettings.itemSpaceBetween}px; --space-between-tb: ${sectionSettings.itemSpaceBetweenTb}px; --space-between-mb: ${sectionSettings.itemSpaceBetweenMb}px;`}>
        {sectionSettings.features.slice(0, sectionSettings.limit).map((feature) => (
          <div class="feature-item">
            <ethan-tilt-card class="feature-tilt-wrap" max-tilt="9" smooth="0.15">
              <div class="feature-item-inner text-align-center">
                <feature.icon />
                <Spacer space={24} spaceTb={20} spaceMb={18} />
                <h3 class="feature-item-title">{feature.title}</h3>
                <Spacer space={12} spaceTb={10} spaceMb={8} />
                <p class="feature-item-description text-secondary" set:html={feature.description}></p>
              </div>
            </ethan-tilt-card>
          </div>
        ))}
      </reveal-grid>
    </div>
  </div>
  <Spacer space={siteConfig.sectionSpace.dk} spaceTb={siteConfig.sectionSpace.tb} spaceMb={siteConfig.sectionSpace.mb} />
</section>

<style>
  .features-section{
    background-color: #fff;
    --item-padding: 64px 40px;
    @media (width < 1150px){
      --item-padding: 40px 20px;
      br{
        display: none;
      }
    }
    @media (width < 767px){
      --item-padding: 32px 16px;
    }
  }
  .features-list {
    display: grid;
    grid-template-columns: repeat(var(--per-row), 1fr);
    gap: var(--space-between);
    @media (width < 1150px){
      grid-template-columns: repeat(var(--per-row-tb), 1fr);
      gap: var(--space-between-tb);
    }
    @media (width < 767px){
      grid-template-columns: repeat(var(--per-row-mb), 1fr);
      gap: var(--space-between-mb);
    }
  }
  .feature-tilt-wrap {
    display: block;
    height: 100%;
    perspective: 520px;
    perspective-origin: 50% 45%;
    -webkit-perspective: 520px;
    -webkit-perspective-origin: 50% 45%;
  }

  .feature-item-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    border-radius: var(--radius-xl);
    background-color: #f0f0f0;
    padding: var(--item-padding);
    height: 100%;
    transform-style: preserve-3d;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
    border: 1px solid transparent;
    will-change: transform;
  }

  .feature-tilt-wrap.is-tilt-active .feature-item-inner {
    box-shadow:
      0 20px 50px rgba(12, 10, 9, 0.12),
      0 8px 20px rgba(12, 10, 9, 0.06);
    border-color: rgba(0, 0, 0, 0.06);
  }

  @media (hover: none) {
    .feature-tilt-wrap {
      perspective: none;
    }

    .feature-item-inner {
      transform: none !important;
      will-change: auto;
    }
  }
  .feature-item-title {
    --fs: 20px;
    --fw: 500;
    --lh:1.3;
    --ls: -3;

    font-size: var(--fs);
    font-weight: var(--fw);
    line-height: var(--lh);
    letter-spacing: calc(var(--fs) * ( var(--ls) / 100));
    color: var(--text);
  }
  .feature-item-description {
    --fs: 16px;
    --fw: 400;
    --lh: 1.35;
    --ls: -3;

    font-size: var(--fs);
    font-weight: var(--fw);
    line-height: var(--lh);
    letter-spacing: calc(var(--fs) * ( var(--ls) / 100));
    color: var(--text-secondary);
  }
  @media (width < 767px){
    .feature-item{
      position: sticky;
      top:0;
    }
  }

</style>