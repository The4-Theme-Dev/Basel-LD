---
<section id="reviews" class="feedback-section">
  <Spacer space={128} spaceTb={70} spaceMb={50} />
  <div class="section-inner">
    <div class="container">
      <div class="section-heading text-align-center">
        <HeadingBadge label={sectionSettings.label} variant="primary" />
        <Spacer space={24} spaceTb={16} spaceMb={16} />
        <Heading level={2} textAlign="center" tag="h2">
          {sectionSettings.title}
        </Heading>
        <Spacer space={24} spaceTb={16} spaceMb={16} />
        <p class="text-align-center text-secondary hide-br-mobile" set:html={sectionSettings.sub}>
        </p>
        <Spacer space={48} spaceTb={32} spaceMb={30} />
      </div>
      <div class="fb-list">
        {sectionSettings.items.map((line, index) => (
          <div class="slide-wrap">
            <Slider type="marquee" direction="vertical" directionMb="horizontal" reverse={index === 1} autoplay={true} interval={0} speed={7000} loop={true} slidesPerView={sectionSettings.itemperRow} slidesPerViewTb={sectionSettings.itemperRowTb} slidesPerViewMb={sectionSettings.itemperRowMb} spaceBetween={sectionSettings.itemSpaceBetween}>
              {line.map((item) => (
                <swiper-slide>
                  <div class="fb-item">
                    <div class="fb-item-inner">
                      <p class="fb-item-review" set:html={item.review}></p>
                      <div class="reviewers">
                        <item.reviewers.avatar />
                        <div class="reviewers-info">
                          <h3 class="reviewers-name">{item.reviewers.name}</h3>
                          <p class="reviewers-position text-secondary">{item.reviewers.position}</p>
                        </div>
                      </div>
                    </div>
                  </div>
                </swiper-slide>
              ))}
            </Slider>
          </div>
        ))}
      </div>
      <div class="section-footer text-align-center">
        <Spacer space={48} spaceTb={32} spaceMb={30} />
        <Button label={sectionSettings.buyButton.label} variant={sectionSettings.buyButton.variant as "primary" | "accent" | "transparent"} href={sectionSettings.buyButton.href} />
      </div>
    </div>
  </div>
  <Spacer space={128} spaceTb={70} spaceMb={50} />
</section>

<style>
  .feedback-section{
    background-color: #fff;
  }
  .fb-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    min-width: 0;
    position: relative;
    --item-padding: 32px;
    --height: 800px;
    .slide-wrap{
      min-width: 0;
    }
    &::before,
    &::after{
      position: absolute;
      content: "";
      height: 6vw;
      width: 100%;
      top: 0;
      left: 0;
      right: 0;
      background: linear-gradient(180deg, #FFFFFF 0%, rgba(255, 255, 255, 0) 100%);
      z-index: 10;
      pointer-events: none;
    }
    &::after{
      top:auto;
      bottom: 0;
      background: linear-gradient(0deg, #FFFFFF 0%, rgba(255, 255, 255, 0) 100%);
    }
    @media (width < 991px){
      gap: 16px;
      --item-padding: 16px;
    }
    @media (width < 767px){
      grid-template-columns: 1fr;
      --height: 600px;
      --item-padding: 16px;
      gap: 16px;
      &::before,
      &::after{
        display: none;
      }
    }
  }
  .fb-item{
    background-color: #fff;
    border: 1px solid #CCCCCC;
    border-radius: var(--radius);
    padding: var(--item-padding);
    @media (width < 767px){
      height: 100%;
    }
  }
  .reviewers{
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 48px;
    @media (width < 991px){
      gap: 16px;
      margin-top: 20px;
    }
    @media (width < 767px){
      margin-top: 16px;
    }
  }
  .fb-item-review{
    @media (width < 767px){
      font-size: 14px;
    }
  }
  .reviewers-name{
    font-weight: 500;
    line-height: 1.3;
    @media (width < 991px){
      font-size: 14px;
    }
    @media (width < 767px){
      font-size: 14px;
    }
  }
  .reviewers-position{
    font-size: 14px;
    margin-top: 8px;
    @media (width < 991px){
      font-size: 12px;
    }
  }
</style>