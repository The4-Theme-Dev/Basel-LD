---
import Heading from "../common/Heading.astro"
import Spacer from "../common/Spacer.astro"

import walletIcon from '../../assets/images/sections/reason/wallet.svg';
import powerIcon from '../../assets/images/sections/reason/power_elite.svg';
import fileIcon from '../../assets/images/sections/reason/file.svg';

const reasons = [
  {
    title: "Save $1,500+ Annually on Apps",
    description: "Basel includes premium features like Product Bundles, Wishlists, Quick View, and AJAX Search built-in. Stop paying for expensive monthly subscriptions for basic store features.",
    Icon: walletIcon
  },
  {
    title: "Elite Author Support",
    description: "Get direct access to our professional support team. We help with technical setup, bug fixes, and general queries to ensure your store runs perfectly 24/7.",
    Icon: powerIcon
  },
  {
    title: "Developer-Friendly Code",
    description: "Clean, well-documented Liquid and JS code. If you need to hire a developer for custom work, they will love working with Basel's organized structure.",
    Icon: fileIcon
  }
]

---

<section class="reason-section">
  <div class="section-inner">
    <Spacer space={128} spaceTb={70} spaceMb={50} />
    <div class="container hide-br-mobile">
      <Heading level={2} textAlign="center" tag="h2">
        Why Choose Basel<br>
        <span class="text-accent">for Your Next Project?</span>
      </Heading>
      <Spacer space={24} spaceTb={20} spaceMb={18} />
      <p class="text-align-center text-secondary">Choosing the right theme is the most important decision for your eCommerce business.<br> Basel isn't just a skin; it's a complete business engine.</p>
      <Spacer space={48} spaceTb={36} spaceMb={30} />
      <div class="reason-list">
        {reasons.map(({title, description, Icon}) => (
          <div class="reason-item">
            <Icon />
            <h3 class="reason-item-title">{title}</h3>
            <p class="reason-item-description text-secondary">{description}</p>
          </div>
        ))}
      </div>
    </div>
    <Spacer space={128} spaceTb={70} spaceMb={50} />
  </div>
</section>

<style>
  .reason-list{
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 33px;
  }
  .reason-item{
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    border-radius: var(--radius-xl);
    background-color: #fff;
    padding: 64px 40px;
    --elevationshadow: #0000000A;
    box-shadow: 0px 24px 24px -12px var(--elevationshadow), 0px 3px 3px -1.5px var(--elevationshadow), 0px 1px 1px -0.5px var(--elevationshadow);
  }
  .reason-item-title{
    margin-top: 24px;
    margin-bottom: 12px;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.6px;
    color: var(--text);
  }
  @media (width < 1150px){
    .reason-list{
      gap: 1rem;
    }
    .reason-item{
      padding: 20px;
    }
  }
  @media (width < 991px){
    .reason-list{
      grid-template-columns: repeat(2, 1fr);
    }
    .reason-item:first-child{
      grid-column: span 2;
    }
    .reason-item-title{
      font-size: 18px;
    }
  }
  @media (width < 767px){
    .reason-list{
      grid-template-columns: 1fr;
    }
    .reason-item:first-child{
      grid-column: span 1;
    }
  }
</style>