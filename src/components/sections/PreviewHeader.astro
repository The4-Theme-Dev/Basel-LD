---
import Spacer from "../common/Spacer.astro";
import { demoHeaderItems } from "../../config/data";
import Heading from "../common/Heading.astro";
import Slider from "../common/Slider.astro";
import ImageRender from "../common/ImageRender.astro";
import { siteConfig } from "../../config/site";
import Button from "../common/Button.astro";

const sectionSettings = {
  headerCount: demoHeaderItems.length,
  title: "Flexible Header Layouts",
  sub: `Design your perfect header experience with fully customizable layouts<br> built for usability and brand identity.`,
  demoPerRow: "auto",
  demoPerRowTb: "auto",
  demoPerRowMb: "auto",
  demoSpaceBetween: 24,
  demoSpaceBetweenTb: 20,
  demoSpaceBetweenMb: 12,
  limit: 99,
  sort: "default",
  imageRatio: "adapt-image"
}

const sizes = `(max-width: 767px) 100vw, (max-width: 1024px) 50vw, 50vw`;

---

<section class="preview-header">
  <div class="section-inner">
    <div class="container">
      <Spacer space={siteConfig.sectionSpace.dk} spaceTb={siteConfig.sectionSpace.tb} spaceMb={siteConfig.sectionSpace.mb} />
      <div class="preview-header-inner">
        <div class="preview-header-left" data-gsap-heading>
          <ethan-counter
            class="heading-count text-accent"
            value={sectionSettings.headerCount}
            suffix="+"
          ></ethan-counter>
          <Spacer space={24} spaceTb={20} spaceMb={18} />
          <Heading level={2} textAlign="left" tag="h2" reveal={false}>
            {sectionSettings.title}
          </Heading>
          <Spacer space={24} spaceTb={20} spaceMb={18} />
          <p class="text-secondary hide-br-mobile" set:html={sectionSettings.sub}></p>
          <Spacer space={48} spaceTb={36} spaceMb={30} />
          <Button label="View Demos" variant="accent" href={siteConfig.liveDemoUrl} />
          <Spacer space={14} spaceTb={0} spaceMb={0} />
        </div>
        <div class="preview-header-right">
          <Slider type="marquee" direction="vertical" autoplay={true} interval={0} speed={3000} slidesPerView={sectionSettings.demoPerRow} slidesPerViewTb={sectionSettings.demoPerRowTb} slidesPerViewMb={sectionSettings.demoPerRowMb} spaceBetween={sectionSettings.demoSpaceBetween}>
            {demoHeaderItems.map((item) => (
              <swiper-slide>
                <div class="wrap">
                  <ImageRender src={item.image} alt={item.title} ratio={sectionSettings.imageRatio as any} sizes={sizes} />
                </div>
              </swiper-slide>
            ))}
          </Slider>
        </div>
      </div>
      <Spacer space={siteConfig.sectionSpace.dk} spaceTb={siteConfig.sectionSpace.tb} spaceMb={siteConfig.sectionSpace.mb} />
    </div>
  </div>
</section>

<style>
  .section-inner{
    margin-inline: auto;
    width: calc(100vw - 160px);
    border-radius: var(--radius-xl);
    background-color: #090909;
    position: relative;
    --text: #fff;
    /* pointer-events: none; */
    &::before{
      content: "";
      position: absolute;
      top: 50%;
      left: 0;
      transform: translateY(-50%) translateX(-50px);
      width: 18vw;
      height: 18vw;
      background-color: var(--accent-color);
      filter: blur(100px);
      opacity: .3;
      border-radius: 9999px;
      pointer-events: none;
    }
    @media (width < 1580px){
      width: calc(100vw - 4vw);
    }
    @media (width < 767px){
      width: 100vw;
      border-radius: 0;
    }
  }
  .wrap{
    border-radius: var(--radius);
    overflow: hidden;
  }
  .preview-header-inner{
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 2rem;
    @media (width < 767px){
      grid-template-columns: 1fr;
    }
  }
  .preview-header-inner > *{
    min-width: 0;
  }
  .preview-header-right{
    --height: 500px;
    --height-tb: 500px;
    --height-mb: 100px;
    position: relative;

    &::before,
    &::after{
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 80px;
      background: linear-gradient(180deg, #090909 0%, rgba(9, 9, 9, 0.8) 50%, rgba(9, 9, 9, 0) 100%);
      z-index: 5;
      pointer-events: none;
    }
    &::after{
      top: auto;
      bottom: 0;
      background: linear-gradient(0deg, #090909 0%, rgba(9, 9, 9, 0.8) 50%, rgba(9, 9, 9, 0) 100%);
    }
  }
  .text-secondary{
    color: #ccc;
  }
</style>